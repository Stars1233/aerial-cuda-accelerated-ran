# Source from channel_only/*.sh:  source "$(dirname "$0")/common.env"
#
# Hardware-specific settings (FREQ, POWER, TARGET_SM) vary by GPU/host.
# Defaults are auto-detected from nvidia-smi when AUTO_DETECT_GPU=1 (default).
# Override any value explicitly before sourcing or on the command line:
#
#   export TARGET_SM=138 FREQ=1980 POWER=900
#   ./pusch_only.sh
#
#   AUTO_DETECT_GPU=0 TARGET_SM=82 FREQ=1605 POWER=165 ./verify_channel_only.sh --quick
#
# F14 64TR Stage-1 reference (GH200, 82 SM, 1605 MHz, 165 W):
#   AUTO_DETECT_GPU=0 FREQ=1605 POWER=165 TARGET_SM=82 ./run_f14_stage1.sh

PERF_DIR="${PERF_DIR:-/opt/nvidia/cuBB/testBenches/perf}"
CHANNEL_DIR="${PERF_DIR}/channel_only"
CUPHY="${CUPHY:-/opt/nvidia/cuBB/build.perf.aarch64/testBenches}"
VECTORS="${VECTORS:-/opt/nvidia/cuBB/testVectors}"
UC="${UC:-${PERF_DIR}/uc_avg_F14_TDD.json}"

GPU="${GPU:-0}"
AUTO_DETECT_GPU="${AUTO_DETECT_GPU:-1}"

# F14 campaign fallbacks when nvidia-smi is unavailable (e.g. dry-run host).
_DEFAULT_FREQ=1605
_DEFAULT_POWER=165
_DEFAULT_TARGET_SM=82

_channel_only_gpu_query() {
  local field="$1"
  nvidia-smi -i "${GPU}" --query-gpu="${field}" --format=csv,noheader,nounits 2>/dev/null \
    | head -1 | tr -d '[:space:]'
}

_channel_only_to_int() {
  local val="$1"
  # nvidia-smi may return floats (e.g. 900.00); measure.py --freq/--power expect int.
  if [[ "${val}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "${val%%.*}"
  else
    echo "${val}"
  fi
}

_channel_only_detect_sm() {
  local sm=""
  # Newer drivers expose multiprocessor_count as a query field.
  sm="$(_channel_only_gpu_query multiprocessor_count)"
  if [[ "${sm}" =~ ^[0-9]+$ ]]; then
    echo "${sm}"
    return
  fi
  # Older drivers (common in Aerial containers): parse nvidia-smi -q output.
  sm="$(nvidia-smi -q -i "${GPU}" 2>/dev/null \
    | awk -F: '/^[[:space:]]*Multiprocessors[[:space:]]*:/ {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit
      }')"
  if [[ "${sm}" =~ ^[0-9]+$ ]]; then
    echo "${sm}"
    return
  fi
  echo ""
}

_detected_freq=""
_detected_power=""
_detected_sm=""
if [[ "${AUTO_DETECT_GPU}" == "1" ]] && command -v nvidia-smi >/dev/null 2>&1; then
  _detected_freq="$(_channel_only_gpu_query clocks.current.graphics)"
  _detected_power="$(_channel_only_gpu_query power.limit)"
  _detected_sm="$(_channel_only_detect_sm)"
fi

# Explicit env vars win; otherwise use nvidia-smi; otherwise F14 reference defaults.
FREQ="${FREQ:-${_detected_freq:-${_DEFAULT_FREQ}}}"
POWER="${POWER:-${_detected_power:-${_DEFAULT_POWER}}}"
TARGET_SM="${TARGET_SM:-${_detected_sm:-${_DEFAULT_TARGET_SM}}}"
FREQ="$(_channel_only_to_int "${FREQ}")"
POWER="$(_channel_only_to_int "${POWER}")"

CELLS_START="${CELLS_START:-6}"
CELLS_CAP="${CELLS_CAP:-6}"
SLOTS="${SLOTS:-30}"
DELAY="${DELAY:-10000}"
TDD_PATTERN="${TDD_PATTERN:-dddsuudddd_mMIMO}"

SWEEP_OUT="${SWEEP_OUT:-$(printf '%03d_sweep_graphs_avg_F14.json' "${TARGET_SM}")}"
