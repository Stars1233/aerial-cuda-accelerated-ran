    "power_iterations": 2000,
    "nsys_slots": 10,
    "nsys_delay": 10000,
    "nsys_iterations": 1,
    "setup_once": true,
    "fallback_gpu": "RTX_PRO_4500",
    "expected_capacity_status": "seeded-from-yaml-cap-update-after-qualified-run"
  },
