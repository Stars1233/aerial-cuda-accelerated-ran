# Auto-select toolchain based on host architecture.
# Delegates to x86-64 or grace-cross depending on CMAKE_HOST_SYSTEM_PROCESSOR.
# Used by the -auto CMakePresets so developers don't need to pick x86/ARM manually.
# Note: this is NOT march=native — it selects the correct cross/native compiler,
# not CPU-specific tuning flags.
if(CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "aarch64")
    include("${CMAKE_CURRENT_LIST_DIR}/grace-cross")
else()
    include("${CMAKE_CURRENT_LIST_DIR}/x86-64")
endif()
